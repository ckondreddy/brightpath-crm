# BrightPath CRM — Supabase Public Client Configuration
# Retrieve these from: Supabase Dashboard > Project Settings > API

# Your Supabase Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Publishable / Anon Client API Key
# IMPORTANT: Never place the secret `service_role` key here. This is bundled into client code.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key
